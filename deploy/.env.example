# ERP-AGENT 容器部署配置
#
#   cp deploy/.env.example deploy/.env
#   编辑 deploy/.env 后 docker compose up -d
#
# 这个文件同时被 mongo 和 backend 两个容器通过 env_file 读取，是唯一的
# 运行时配置源。项目根的 .env 是本地开发配置，容器部署不读它。

# ============================================================
# MongoDB
# ============================================================
# 下面两个变量由 mongo 官方镜像在**首次初始化数据卷**时消费。
# 改完必须 docker compose down -v 让数据卷重建，否则不生效。
MONGO_INITDB_ROOT_USERNAME=erpadmin
# 换成自己的密码（纯 hex / 无特殊字符最省事）
MONGO_INITDB_ROOT_PASSWORD=xxxx

# 完整连接串，账号密码必须与上面一致。
# 密码含 @ : / 等字符时要 URL 编码（@ → %40）。
MONGODB_URI=mongodb://erpadmin:xxxx@mongo:27017/erp_agent?authSource=admin
MONGODB_DB_NAME=erp_agent

# ============================================================
# LLM（必填）
# ============================================================
DEEPSEEK_API_KEY=
LLM_MODEL=deepseek-flash
LLM_BASE_URL=https://api.deepseek.com
WEB_SEARCH_MODEL=deepseek-flash
DEEPSEEK_RESPONSES_URL=https://api.deepseek.com/responses
LLM_REASONING_EFFORT=high

# ============================================================
# 对外地址（必填）
# ============================================================
# 生成给用户看的下载链接用的根地址，必须是浏览器能打开的地址。
# 不要写容器内的 http://backend:8000 —— 用户点开必然失败。
# 例如 http://192.168.1.50 或 https://erp.example.com
PUBLIC_BASE_URL=http://localhost

# 逗号分隔。走 nginx 后前后端同源，本项实际不再生效，只服务直连后端的本地开发。
CORS_ALLOW_ORIGINS=http://localhost

# ============================================================
# HTTPS / TLS（容器部署强烈建议开启）
# ============================================================
# Basic Auth 明文在 HTTP 上传输 = 密码直接泄露。生产环境必须开 TLS。
#
# 用法：
#   1) 在 deploy/nginx.env 里设 TLS_ENABLED=1（与 INTERNAL_AUTH_TOKEN 同文件）
#   2) 把证书放在 deploy/nginx/tls/cert.pem 和 key.pem
#      （bootstrap.sh 会自动生成：有域名走 certbot，否则 openssl 自签）
#   3) docker compose up -d nginx
#
# TLS_ENABLED 留空 = 纯 HTTP（开发 / CI 默认，与加 TLS 前完全一致）。
# TLS_ENABLED=1   = 启用：80 → 443 跳转，443 跑 ssl + 同一套 location。
#
# HTTPS_PORT 只在 compose 端口映射里用，nginx 内部固定监听 443。
HTTPS_PORT=443

# ============================================================
# 镜像仓库（可选，生产环境强烈建议配置）
# ============================================================
# 配置后 build.sh 会 --push 到 registry，deploy.sh 会先 docker pull。
# 留空 = 完全本地模式（构建机 == 运行机，机器丢 = 镜像全丢 + 回滚归零）。
#
# 例：
#   REGISTRY_URL=registry.cn-hangzhou.aliyuncs.com
#   REGISTRY_USER=erp@xxx
#   REGISTRY_PASSWORD=xxx
# 凭据走 ~/.docker/config.json（bootstrap.sh 用 docker login 写入），
# 不经 env_file。
REGISTRY_URL=
REGISTRY_USER=
REGISTRY_PASSWORD=

# ============================================================
# 可观测性（可选）
# ============================================================
# Prometheus 数据保留时间。留空 = 默认 15 天。
PROMETHEUS_RETENTION=15d
# Grafana 管理员密码。留空 = 随机生成并打印一次（仅 bootstrap 时）。
GRAFANA_PASSWORD=
# Grafana 对外端口。留空 = 默认 13000（避开常用端口）。
GRAFANA_PORT=13000

# ============================================================
# 沙箱
# ============================================================
SANDBOX_IMAGE=python:3.11-slim
SANDBOX_WARM_POOL_SIZE=1
SANDBOX_IDLE_TIMEOUT_MINUTES=30
# dind 冷启动时容器创建里可能夹着镜像 pull，SDK 默认 60s 不够。
# 这个值同时是沙箱内 timeout(1) 的上限：必须大于 sandbox_setup 里最长的单命令
# 超时 900s，否则长命令会先撞上客户端 socket 超时、丢掉"[超时]"这个原因
# （见 custom_opensandbox.execute 的 clamp 与 config.py 的注释）。
DOCKER_TIMEOUT_SECONDS=1200

# 沙箱内的代码按这个地址访问 MCP Server。两个都留空 = 沙箱里没有 MCP 能力。
#
# HOST_IP 必须是 mcp 在 mcp-sandbox 网络上的**静态 IP**（见
# docker-compose.yml 里 mcp 服务的 ipv4_address），两边改一处必须改两处。
# 沙箱容器跑在 dind 自己的 bridge 里，解析不了 compose 的服务名，只能靠
# backend 把这个 IP 写进容器的 /etc/hosts。
#
# 不对公网暴露 MCP 的话，这项可以整段注释掉。
SANDBOX_MCP_URL=http://mcp:9000
SANDBOX_MCP_HOST_IP=172.31.0.10

# ============================================================
# 认证（容器部署必须设置）
# ============================================================
# nginx 与 backend 之间的共享密钥。nginx 把它渲染成模板里的 $internal_token，
# 作为 X-Internal-Auth 注入每个 /api 请求；backend 在 AUTH_MODE=proxy 下校验它。
#
# 挡的是什么：AUTH_MODE=proxy 只信 X-Authenticated-User，而 backend 与 dind 同
# 在一张 Docker 网络上、沙箱容器又跑在 dind 里 —— 也就是沙箱中模型生成的代码
# 可以绕过 nginx 直连 backend，自己填一个别人的用户名，读到别人的会话历史。
# 这个值只存在于 nginx 与 backend 进程环境里，沙箱代码拿不到。
#
# 必须与 deploy/nginx.env 里的同名项一致，用脚本一次写两处：
#   sh deploy/set_internal_token.sh
# 改完要重建容器（env_file 在创建时注入，restart 不重读）：
#   docker compose up -d backend nginx
#
# 留空 = 不校验（本机开发默认行为）。为空的容器部署会在 backend 启动日志里
# 打一条 WARNING。
INTERNAL_AUTH_TOKEN=

# ============================================================
# 三层记忆（均可不配，走默认值）
# ============================================================
MEMORY_WARM_EPISODE_DAYS=7
MEMORY_EPISODE_TTL_DAYS=90
MEMORY_RETRIEVAL_K=5
MEMORY_MAX_EPISODES=200
MEMORY_TOOLS_ENABLED=true
MEMORY_LLM_EXTRACTION=false
