# nginx 容器的独立环境文件（刻意与 deploy/.env 分开：nginx 只需要这一个值，
# 不该顺带拿到 CHATANYWHERE_API_KEY 之类的后端密钥）。
#
# 这个文件是模板，真实的 deploy/nginx.env 已在 .gitignore 里，不要提交。
#   cp deploy/nginx.env.example deploy/nginx.env
#
# INTERNAL_AUTH_TOKEN 必须与 deploy/.env 里的同名项一致 —— nginx 用它注入
# X-Internal-Auth，backend 用它校验。两边不一致 = 所有 /api 请求 401。
# 用 deploy/set_internal_token.sh 一次性写入两处，避免手工同步出错：
#   sh deploy/set_internal_token.sh
#
# 留空 = 不启用这道校验（本机开发默认；容器部署请设置）。
INTERNAL_AUTH_TOKEN=

# HTTPS 开关。=1 启用：80 → 443 跳转，证书从 deploy/nginx/tls/{cert,key}.pem
# 读取（由 bootstrap.sh 生成）。留空 = 纯 HTTP（开发 / CI 默认）。
# Basic Auth 明文在 HTTP 上传输 = 密码直接泄露，生产环境必须设为 1。
TLS_ENABLED=
