#!/usr/bin/env bash
# /srv/erp-agent.git/hooks/post-receive —— 本地直推部署的触发点。
#
# 安装（一次性，在服务器上以 root 执行）：
#   cp /root/erp-agent/deploy/cloud/post-receive.hook /srv/erp-agent.git/hooks/post-receive
#   chmod 755 /srv/erp-agent.git/hooks/post-receive
#
# 只对 refs/heads/main 触发部署；其余分支与 tag 只存进裸仓库，不部署 ——
# 推特性分支到这里等于白得一份服务器侧备份，没有任何副作用。
#
# 执行的是**生产树**里的 push-deploy.sh：本次推送对它自身的改动从下一次推送才生效
#（与 deploy.sh 的语义一致 —— 在跑的发布永远由旧版脚本完成）。
set -euo pipefail

PUSH_DEPLOY="${PUSH_DEPLOY_SCRIPT:-/root/erp-agent/deploy/cd/push-deploy.sh}"

while read -r oldrev newrev refname; do
    [ "$refname" = "refs/heads/main" ] || continue
    # 分支删除时 newrev 是全 0 —— 没有可部署的 commit。
    case "$newrev" in *[!0]*) ;; *) continue ;; esac
    # stdin 重定向掉：push-deploy.sh 的子命令若读 stdin，会把后续 ref 行吃掉。
    "$PUSH_DEPLOY" "$newrev" < /dev/null
done
