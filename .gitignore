# ============ 环境变量（含 API Key，严禁提交） ============
.env
.env.*
!.env.example
!.env.sample

# ============ Python ============
__pycache__/
*.py[cod]
*$py.class
*.egg-info/
.eggs/
.venv/
.venv
venv/
env/
ENV/
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
htmlcov/
build/
dist/

# ============ Node.js / Next.js ============
node_modules/
.next/
out/
*.tsbuildinfo
next-env.d.ts

# ============ 生成文件 / 下载目录 ============
src/download/

# ============ 发布状态 ============
# deploy/cd/state/ 是「这台机器当前跑的是哪一版」的真值源，只对本机有意义。
# 它同时是回滚的依据，被同步覆盖会让回滚指向错误的版本。
deploy/cd/state/

# ============ 认证凭据 ============
# nginx Basic Auth 的密码哈希
deploy/nginx/htpasswd
# nginx ↔ backend 共享密钥。deploy/set_internal_token.sh 会把真实值同时写进
# 这里和 deploy/.env，所以不能入库 —— 仓库里只留 deploy/nginx.env.example 模板。
deploy/nginx.env

# ============ 临时脚本 ============
/tmp/

# ============ 日志 ============
*.log

# ============ IDE / 系统 ============
.vscode/
.idea/
.DS_Store
Thumbs.db
